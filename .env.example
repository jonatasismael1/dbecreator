# Supabase Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA Config (OpenRouter)
# IMPORTANTE: Nunca exponha OPENROUTER_API_KEY no frontend!
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_MODEL=openrouter/free

# App Config
VITE_APP_NAME=DBE Creator
VITE_APP_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Instagram OAuth server-side config. Never expose INSTAGRAM_APP_SECRET or tokens in the frontend.
# INSTAGRAM_CLIENT_ID / INSTAGRAM_CLIENT_SECRET are accepted aliases for Supabase Edge Function compatibility.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://dbecreator.netlify.app/auth/instagram/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v25.0
