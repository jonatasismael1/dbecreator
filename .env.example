# Supabase Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA Config (OpenRouter)
# IMPORTANTE: Nunca exponha OPENROUTER_API_KEY no frontend!
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_MODEL=openrouter/free

# App Config
VITE_APP_NAME=DBE Creator
VITE_APP_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Meta OAuth public app id. The app secret must only be configured as Supabase secret META_APP_SECRET.
VITE_META_APP_ID=
META_APP_ID=
META_APP_SECRET=
