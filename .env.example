# Supabase Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA Config (OpenRouter)
# IMPORTANTE: Nunca exponha OPENROUTER_API_KEY no frontend!
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_MODEL=openrouter/free

# App Config
VITE_APP_NAME=DBE Creator
VITE_APP_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Meta OAuth server-side config. Never expose META_APP_SECRET or tokens in the frontend.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_REDIRECT_URI=http://localhost:8888/api/meta/callback
META_TOKEN_ENCRYPTION_KEY=
